<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows both HTTP (LAN) and HTTPS (ngrok) connections.
    Trusts system + user-installed certificates.
    Place this file in:  app/src/main/res/xml/network_security_config.xml
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
